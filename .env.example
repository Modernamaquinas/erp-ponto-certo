# ---------------------------------------------------------------- Frontend (Vite) — vão para o navegador
VITE_SUPABASE_URL=https://SEUPROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------- Servidor (Vercel) — NUNCA no navegador
SUPABASE_URL=https://SEUPROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Asaas (Minha Conta > Integrações > Chave de API). Comece em sandbox; troque para producao quando validar.
ASAAS_AMBIENTE=sandbox
ASAAS_API_KEY=
# Token que você define ao cadastrar o webhook no Asaas (Integrações > Webhooks), URL https://SEUDOMINIO/api/asaas-webhook
ASAAS_WEBHOOK_TOKEN=
# UNDEFINED = cliente escolhe boleto, PIX ou cartão na fatura | BOLETO | PIX
ASAAS_TIPO_COBRANCA=UNDEFINED
ASAAS_MULTA_PERCENTUAL=2
ASAAS_JUROS_MENSAL_PERCENTUAL=1

# ---------------------------------------------------------------- Migração / sincronização (computador da loja)
# Supabase > Project Settings > Database > Connection string (URI, "Session pooler")
DATABASE_URL=postgresql://postgres.SEUPROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
FIREBIRD_HOST=DESKTOP-8LQ068N
FIREBIRD_PORT=3050
FIREBIRD_DATABASE=C:\EASYCONTROL\Dados\Banco.fdb
FIREBIRD_USER=SYSDBA
FIREBIRD_PASSWORD=masterkey

# TEF do caixa (Fase 2, docs/tef-cielo.md). simulador = aprova tudo sem PinPad (treino/desenvolvimento)
VITE_TEF_MODO=
VITE_TEF_AGENTE_URL=http://127.0.0.1:7171

# Fiscal — Focus NFe (docs/fiscal.md)
# Vercel: FOCUS_TOKEN_HOMOLOGACAO e FOCUS_TOKEN_PRODUCAO (tokens da empresa, gerados por npm run fiscal:configurar)
FOCUS_TOKEN_HOMOLOGACAO=
FOCUS_TOKEN_PRODUCAO=
# Só no .env local: token principal da conta e dados do certificado/CSC (vão direto do PC para a Focus)
FOCUS_TOKEN=
EMPRESA_EMAIL=
CERTIFICADO_ARQUIVO=certificado/ponto-certo.pfx
CERTIFICADO_SENHA=
NFCE_ID_CSC=
NFCE_CSC=
NFCE_ID_CSC_HOMOLOGACAO=
NFCE_CSC_HOMOLOGACAO=

# Marketplaces (Mercado Livre pela edge function ml-estoque do Supabase do painel financeiro da Ponto Certo) — scripts/configurar-marketplaces.mjs
ML_ESTOQUE_URL=https://<projeto-do-painel-ponto-certo>.supabase.co/functions/v1/ml-estoque
